{
  "name": "@gym-saas/mobile",
  "version": "0.0.1",
  "description": "Mobile app for gym management (iOS/Android)",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "expo": "^50.0.0",
    "expo-router": "^3.4.0",
    "expo-status-bar": "^1.11.0",
    "expo-splash-screen": "^0.26.0",
    "expo-font": "^11.10.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-screens": "^3.27.0",
    "react-native-safe-area-context": "^4.8.0",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.5",
    "zustand": "^4.4.1",
    "zod": "^3.22.4",
    "react-hook-form": "^7.48.0",
    "@react-native-camera-roll/camera-roll": "^7.2.0",
    "expo-camera": "^13.4.0",
    "expo-barcode-scanner": "^12.6.0",
    "expo-notifications": "^0.27.0",
    "expo-constants": "^15.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@testing-library/react-native": "^12.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^49.0.0",
    "ts-jest": "^29.1.1"
  }
}
