# Supabase Configuration
# Get these values from your Supabase project dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Click "Settings" → "API"
# 4. Copy the values below

# Public API URL (safe to expose to frontend)
# Found under: Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (safe to expose to frontend)
# Found under: Settings → API → Project API keys → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
